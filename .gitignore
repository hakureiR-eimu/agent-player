node_modules/

# 飞书应用凭证和大模型 APIKey 不进版本库
config/feishu.json
config/llm.json

# 局内生长的数据不进版本库（profile 和目录结构进）
agents/*/world/chat/*.md
!agents/*/world/chat/.gitkeep
agents/*/memory/*.md
!agents/*/memory/.gitkeep

# 局文件夹（建局时生成在仓库根，形如 局名/agents/<tag>/）整局不进 git
/*/agents/
/*/game.json

# 当前局指针（保存并退出/继续游戏用）
state.json

# wiki 镜像原始抓取缓存（~90MB API JSON，可随时重新抓取）
.cache/
